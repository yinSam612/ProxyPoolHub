[Unit]
Description=ProxyPoolHub Multi-Protocol Proxy Pool Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/proxypoolhub
EnvironmentFile=-/opt/proxypoolhub/.env
ExecStart=/usr/bin/node /opt/proxypoolhub/server.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
