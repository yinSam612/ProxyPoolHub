[Unit]
Description=Proxy SOCKS5 and HTTP relay manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy-socks5
Group=proxy-socks5
WorkingDirectory=/opt/proxy-socks5
EnvironmentFile=/etc/proxy-socks5.env
ExecStart=/usr/bin/node /opt/proxy-socks5/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/opt/proxy-socks5/data /opt/proxy-socks5/runtime

[Install]
WantedBy=multi-user.target
